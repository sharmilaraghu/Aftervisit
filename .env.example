# Copy this file, then fill in values yourself:
#   cp .env.example .env
# Never commit .env. Calls are live whenever CALLE_API_KEY is set.

# Neon Postgres (pooled URL). Without this, data pages throw a named error.
DATABASE_URL=

# CALL-E. Leave empty until you intend to dial. Empty = nothing can be dialled.
CALLE_API_KEY=

# Optional override for the CALL-E API host. Leave empty for the default.
CALLE_BASE_URL=

# OpenAI. The note compiler and the call-triage model. Without it, compiling a
# note is refused and the review screen shows a blank, hand-editable plan — it
# never invents a generic follow-up — and every finished call is escalated to a
# clinician unjudged rather than quietly marked fine.
OPENAI_API_KEY=

# ElevenLabs. Demo-video media only — `pnpm media` (scripts/elevenlabs.ts). The app
# never reads it. Set the base URL only for a data-residency account, e.g.
# https://api.in.residency.elevenlabs.io.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=

# The deployment lock: which numbers this instance may dial.
#
# LEFT EMPTY, NOTHING IS DIALLED. Every scheduled call is refused with a visible
# reason, even with CALLE_API_KEY set. That is the default on purpose: there is
# no auth, so anyone who can load the console can enrol a patient and record
# consent for them — consent alone cannot decide whether a public instance may
# reach the outside world.
#
#   empty                          → locked (the no-call default)
#   +14155550100,+14155550117      → only these numbers
#   *                              → any patient whose consent is `granted`
#
# Consent is enforced either way: `lib/calle/port.ts` refuses any patient whose
# consent is not an explicit `granted`, whatever this variable says.
CARELOOP_CALL_ALLOWLIST=

# Who the agent says it is calling for, and from where. BOTH ARE SPOKEN TO THE
# PATIENT: "this is {practice}'s AI assistant calling on behalf of {clinician}".
# They are also recorded against every approval and every resolved escalation.
# Unset falls back to the demo fixtures, which are fictional.
CARELOOP_PRACTICE_NAME=
CARELOOP_CLINICIAN_NAME=

# How the agent sounds. The only voice control the API exposes.
CARELOOP_CALL_LOCALE=en-US

# Shared secret for POST /api/tick (header x-careloop-tick). This is the door an
# external cron uses. Unset means the endpoint is CLOSED (503), never open.
# Generate with: openssl rand -hex 32
CARELOOP_TICK_TOKEN=

# Vercel's cron secret, guarding GET /api/cron/tick. Vercel's scheduler sends a
# plain GET with `Authorization: Bearer $CRON_SECRET` and cannot set a custom
# header, which is why that route exists separately from /api/tick. Set this and
# Vercel injects it automatically. Unset means that endpoint is closed too.
# Note: on Vercel's Hobby plan crons run at most once a day, which proves the
# mechanism but will not drive a follow-up schedule. Use an external cron against
# POST /api/tick, or the console's own 15s poller, for anything faster.
CRON_SECRET=

# Where this instance is reachable from the internet, e.g. https://careloop.example.
# Set together with CARELOOP_WEBHOOK_TOKEN and Care Loop hands CALL-E a webhookUrl,
# so a finished call lands promptly instead of waiting for the next tick to poll.
# Unset on a laptop, which is the normal case — the reconciler still catches
# everything, just later.
CARELOOP_PUBLIC_URL=

# Shared secret in the query string of POST /api/calle/webhook. CALL-E's webhooks
# are UNSIGNED, so this is not authentication — it only keeps stray traffic out.
# The receiver re-fetches the call through the authenticated API before believing
# anything a webhook claims. Unset means the endpoint is closed (503).
# Generate with: openssl rand -hex 32
CARELOOP_WEBHOOK_TOKEN=

# The number the lead demo patient is seeded with. Unset, they keep a fictional
# `555-01xx` number and never ring — during the exact demo where they are meant
# to. Read at seed time only; nothing in the app reads it.
CARELOOP_SEED_PHONE_PRIMARY=

# Second line used for the retry demo. Must actually not answer.
# Do not seed fake no_answer rows.
CARELOOP_UNANSWERED_PHONE=
