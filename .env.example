# Copy this file, then fill in values yourself:
#   cp .env.example .env
# Never commit .env. Calls are live whenever CALLE_API_KEY is set.

# Neon Postgres (pooled URL). Without this, data pages throw a named error.
DATABASE_URL=

# CALL-E. Leave empty until you intend to dial. Empty = nothing can be dialled.
CALLE_API_KEY=

# Optional override for the CALL-E API host. Leave empty for the default.
CALLE_BASE_URL=

# Gemini. The note compiler's primary model. Without this and OPENAI_API_KEY,
# compiling a note is refused and the review screen shows a blank, hand-editable
# plan. It never invents a generic follow-up.
GEMINI_API_KEY=

# OpenAI. Fallback only, used when Gemini is unset or errors. Optional.
OPENAI_API_KEY=

# Comma-separated E.164 numbers the scheduler may dial. Empty = dial nobody.
# Example: +14155550100,+14155550117
#
# This gate exists because there is no auth. With a login, "a clinician approved
# this plan" would itself authorise the dial; on a public URL it proves an action
# happened but nothing about who did it.
#
# Set to * to open the gate — any number on an approved plan may then be called.
# That is an explicit opt-out, never a default: empty still means dial nobody, so
# forgetting to configure this can only ever fail closed.
CARELOOP_CALL_ALLOWLIST=

# How the agent sounds. The only voice control the API exposes.
CARELOOP_CALL_LOCALE=en-US

# Shared secret for POST /api/tick (header x-careloop-tick).
# Generate with: openssl rand -hex 32
CARELOOP_TICK_TOKEN=

# Second line used for the retry demo. Must actually not answer.
# Do not seed fake no_answer rows.
CARELOOP_UNANSWERED_PHONE=
