# Secrets. .env holds a live Neon connection string and, once armed, real phone
# numbers. Only the example is ever committed.
.env
.env.*
!.env.example

# `docs/TESTING.md` holds the real numbers the live scenarios dial, so docs/
# stays out — except the README's screenshots, which must ship or every image on
# GitHub (and in the awesome-list catalog) is broken. `docs/*` rather than
# `docs/`, because git cannot re-include a file inside an excluded directory.
docs/*
!docs/screenshots/

# Demo-video media from `pnpm media` — rendered on demand, never committed.
media/generated/

node_modules/
.next/
out/
build/
next-env.d.ts

.DS_Store
*.tsbuildinfo

# Plugin scratch space.
.impeccable/config.local.json
.remember/

.impeccable/
.codex/
.claude/
.cursor/
.next/
.remember/
# `misc/` is a working clone of CALLE-AI/awesome-phone-call-agents, kept for
# reference. It is someone else's repository and never ours to commit.
#
# `skill/` and `scripts/` used to be listed here, which meant the installable
# skill the submission is built around and the seed the README tells a reader to
# run were both absent from every clone. Both are tracked now.
misc/

demo/

docs/

